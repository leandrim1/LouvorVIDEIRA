# Copie para .env.local e preencha. NUNCA coloque valores reais neste arquivo.
# Na Vercel, estas variáveis são configuradas no painel (Settings → Environment Variables)
# ou criadas automaticamente pelas integrações Neon e Vercel Blob.
# Para trazer as variáveis da Vercel para sua máquina: vercel env pull .env.local

# --- Banco de dados (Neon PostgreSQL) -------------------------------------------
# Criada pela integração Neon da Vercel. Usada apenas no servidor (API, migrations e seed).
# Deixe vazia no desenvolvimento para usar um PostgreSQL local em .pglite/.
DATABASE_URL=

# --- Arquivos (Vercel Blob) -----------------------------------------------------
# Criada ao conectar um Blob store ao projeto na Vercel. Usada apenas no servidor.
BLOB_READ_WRITE_TOKEN=

# --- E-mails transacionais -----------------------------------------------------
# Obrigatório um dos dois provedores. Se as variáveis do Gmail estiverem preenchidas, ele é usado.

# Opção 1 — Gmail (sem domínio próprio): conta do Google com verificação em duas etapas
# e uma "senha de app" (https://myaccount.google.com/apppasswords). Usadas apenas no servidor.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Opção 2 — Resend (exige domínio próprio verificado)
# Chave da API do Resend (https://resend.com/api-keys). Usada apenas no servidor.
RESEND_API_KEY=
# Remetente com domínio verificado no Resend. Ex.: Louvor Videira <nao-responda@seudominio.com.br>
# (com o Gmail é opcional: o remetente é sempre a própria conta)
EMAIL_FROM=
# Obrigatório nos dois casos. Endereço público do site, usado nos links dos e-mails. Ex.: https://louvor-videira.vercel.app
# (no desenvolvimento: http://localhost:5173)
APP_URL=

# --- Notificações push (Web Push / VAPID) ---------------------------------------
# Gere o par de chaves com: npm run push:keys  (gere uma vez e não troque depois,
# senão os aparelhos precisam ativar as notificações de novo).
# A chave pública pode ir para o navegador (é entregue pela API); a privada fica só no servidor.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato do responsável, exigido pelos serviços de push. Ex.: mailto:adminlouvorvideira@gmail.com
VAPID_SUBJECT=

# --- Opcionais -----------------------------------------------------------------
# Se definido, somente este e-mail pode criar a primeira conta (administrador).
ADMIN_EMAIL=

# Administrador criado pelo seed de desenvolvimento (npm run db:seed).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Frontend: "demo" publica uma versão de demonstração sem banco (dados no navegador).
# Deixe vazio para usar a API com o banco de dados.
VITE_DATA_PROVIDER=
